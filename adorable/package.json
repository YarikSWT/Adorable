{
  "name": "assistant-ui-starter-cloud",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file-if-exists=.env lib/db/seed/run.ts",
    "db:reset": "tsx --env-file-if-exists=.env lib/db/seed/reset.ts"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "app/globals.css"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.24",
    "@ai-sdk/openai": "^3.0.19",
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@assistant-ui/react": "^0.12.1",
    "@assistant-ui/react-ai-sdk": "^1.3.1",
    "@assistant-ui/react-markdown": "^0.12.0",
    "@better-auth/drizzle-adapter": "^1.6.9",
    "@mastra/mcp": "^1.0.0",
    "@openrouter/ai-sdk-provider": "^2.8.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "ai": "^6.0.50",
    "argon2": "^0.44.0",
    "better-auth": "^1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockerode": "^4.0.10",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.29.2",
    "ioredis": "^5.11.0",
    "lucide-react": "^0.563.0",
    "motion": "^12.29.2",
    "next": "16.1.5",
    "nodemailer": "^8.0.7",
    "pg-boss": "^10.4.2",
    "postgres": "^3.4.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-gfm": "^4.0.1",
    "resumable-stream": "^2.2.12",
    "tailwind-merge": "^3.4.0",
    "tar-stream": "^3.1.8",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.3",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/dockerode": "^3.3.47",
    "@types/node": "^25",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tar-stream": "^3.1.4",
    "@vitest/expect": "^4.1.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.5",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "testcontainers": "^11.14.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
