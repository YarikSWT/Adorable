# ==============================================================================
# Adorable fork — пример .env. Скопируйте в .env и заполните реальными значениями.
# ==============================================================================

# -------- LLM --------
# Провайдер: zai (основной) | openrouter | anthropic | openai | mock
LLM_PROVIDER=zai

# Z.ai (основной путь — работает из РФ)
Z_AI_API_KEY=
Z_AI_BASE_URL=https://api.z.ai/api/paas/v4

# Основная и быстрая модели
LLM_MAIN_MODEL=glm-5.1
LLM_FAST_MODEL=glm-4.5-air

# Альтернативный путь через OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Fallback (опционально)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# -------- Auth (Better Auth) --------
# Сгенерировать: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# -------- Postgres (app) --------
APP_POSTGRES_PASSWORD=adorable_dev_password
# В self-hosted DATABASE_URL формируется из этого пароля и адреса postgres-app.
DATABASE_URL=postgres://adorable:adorable_dev_password@localhost:5432/adorable

# -------- Gitea --------
GIT_PROVIDER=gitea
# Если 3001 занят на хосте — поменяй GITEA_HOST_PORT (и соответственно GITEA_BASE_URL / GITEA_ROOT_URL).
GITEA_HOST_PORT=3001
GITEA_BASE_URL=http://localhost:3001
GITEA_DOMAIN=localhost
GITEA_ROOT_URL=http://localhost:3001/
# Сгенерировать: openssl rand -base64 24
GITEA_ADMIN_PASSWORD=
GITEA_ADMIN_USER=adorable
GITEA_ADMIN_EMAIL=admin@adorable.local
GITEA_POSTGRES_PASSWORD=gitea_dev_password
# Создаётся скриптом scripts/init-gitea.sh --write-env
GITEA_TOKEN=

# -------- Sandbox (Docker) --------
SANDBOX_PROVIDER=docker
SANDBOX_NETWORK_NAME=adorable_sandboxes
# CPU лимит в долях ядра (NanoCpus = value * 1e9). 2 = 2 ядра.
SANDBOX_CPU_LIMIT=2
# Память в байтах. Next.js dev + Turbopack + агент — тесно в 2 GiB, берём 4.
# 4 GiB = 4294967296
SANDBOX_MEMORY_LIMIT=4294967296
# Next dev + watchers легко делают 500+ процессов. 1024 с запасом.
SANDBOX_PIDS_LIMIT=1024
# Max storage для overlay2+xfs (в байтах). 5 GiB = 5368709120.
# На ext4 оставь пустым — docker откажется создавать контейнер с StorageOpt.
SANDBOX_STORAGE_LIMIT=5368709120
# Размер tmpfs для рабочей директории (`/workspace`). Отдельно от
# SANDBOX_STORAGE_LIMIT, т.к. это in-memory mount. 6 GiB = 6442450944 —
# хватает на Next.js + node_modules + .next cache.
SANDBOX_WORKSPACE_SIZE_BYTES=6442450944
# Размер tmpfs для `/tmp` (npm кэш + rename'ы). 1 GiB = 1073741824.
SANDBOX_TMP_SIZE_BYTES=1073741824
# ulimit nofile — webpack/tsc watch открывает тысячи fd.
SANDBOX_ULIMIT_NOFILE=4096
# TTL и idle-timeout (минут) для sandbox. Cleanup-воркер.
SANDBOX_MAX_LIFETIME_MIN=120
SANDBOX_IDLE_TIMEOUT_MIN=30
SANDBOX_CLEANUP_INTERVAL_SEC=60
# Куда писать audit log (JSON lines)
SANDBOX_AUDIT_LOG=/tmp/adorable-sandbox-audit.log
# Образ sandbox
SANDBOX_IMAGE=node:22-slim
# Путь к сокету Docker хоста (билдер локально) или внутри compose (/var/run/docker.sock пробрасывается)
DOCKER_SOCKET=/var/run/docker.sock

# -------- Proxy (Caddy) --------
PROXY_PROVIDER=caddy
CADDY_ADMIN_URL=http://localhost:2019
# Префикс домена для preview (будет: <sandboxId>.<PREVIEW_DOMAIN_SUFFIX>)
PREVIEW_DOMAIN_SUFFIX=preview.localhost
# http в dev, https в проде
PREVIEW_PROTOCOL=http
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# -------- Preview Provider (sandbox | static | mock) --------
# Какой провайдер превью использует builder. До Phase 6 acceptance default = sandbox.
# После Phase 6 default переключится на static (см. docs/preview-provider/MIGRATION_PATH.md).
PREVIEW_PROVIDER=sandbox
# Префикс имени build-runner образа. Полное имя: <prefix>react:<boilerplateVersion>.
BUILD_RUNNER_IMAGE_PREFIX=build-runner-
# Memory limit билд-контейнера, байт. 2 GiB = 2147483648.
BUILD_RUNNER_MEMORY=2147483648
# CPU лимит build-runner'а в долях ядра (NanoCpus = value * 1e9).
BUILD_RUNNER_CPUS=2
# --pids-limit для build-runner'а.
BUILD_RUNNER_PIDS=512
# Hard timeout одного билда, мс. По истечении — SIGKILL контейнеру.
BUILD_RUNNER_TIMEOUT_MS=120000
# Имя isolated docker сети для build-runner'а (internal, без интернета).
BUILD_RUNNER_NETWORK=adorable_build
# SIGTERM grace до SIGKILL при cancel'е билда, мс.
BUILD_CANCEL_GRACE_MS=2000
# Buffer на top of (timeoutMs + 2*cancelGraceMs) перед force-remove
# контейнера. Защита от зависания dockerode container.wait() при
# нагруженном daemon. По истечении — container.remove({force:true}) и
# build считается timed-out.
BUILD_WAIT_DEADLINE_BUFFER_MS=5000
# Cap на stdout/stderr билда (байт). 16 KB.
BUILD_LOG_MAX_BYTES=16384
# Сколько builds/<ts>/ хранить на проект.
BUILD_HISTORY_LIMIT=5
# UI upload size cap (байт). 5 MiB = 5242880.
UPLOAD_MAX_BYTES=5242880
# TTL по inactivity для scratch dir (дней). См. docs/preview-provider/OPEN_QUESTIONS.md.
SCRATCH_DIR_TTL_DAYS=30
# TTL для готовых артефактов под /data/static/<id>/builds/* (дней).
STATIC_DIR_TTL_DAYS=90
# Корень scratch dir на builder'е (project source files).
PROJECTS_ROOT=/data/projects
# Корень static-артефактов на builder'е (Caddy file_server смотрит сюда).
STATIC_ROOT=/data/static
# Container-internal путь, который видит adorable-caddy для того же
# контента что и STATIC_ROOT (см. ADR-031). STATIC_ROOT bind-маунтится
# в adorable-caddy на этот путь, и file_server route использует именно
# его. Если caddy и Node работают на одной FS на одном пути — оставь
# равным STATIC_ROOT для no-op rewrite.
CADDY_STATIC_ROOT=/data/static
# Префикс именованного docker volume под node_modules build-runner'а.
# Полное имя: <prefix><boilerplateVersion>. См. BUILD_PIPELINE.md §4.
# BUILD_RUNNER_NODE_MODULES_VOLUME_PREFIX=adorable_node_modules_react_
# Override для PREVIEW_DOMAIN_SUFFIX в URL'ах "опубликованных" проектов
# (Promote). Default — равен PREVIEW_DOMAIN_SUFFIX.
# PUBLISHED_DOMAIN_SUFFIX=
# Public-port suffix preview URL'ов (":8080" etc.). Default — derived
# from CADDY_HTTP_PORT, либо пусто для 80/443.
# PREVIEW_PUBLIC_PORT=
# Override корня templates/ (для тестов/dev). Default — встроенный.
# ADORABLE_TEMPLATE_DIR=
# Интервал keep-alive comment'а в SSE-стриме build-status, мс.
SSE_KEEP_ALIVE_MS=15000
# Emergency-rollback флаг (MIGRATION_PATH §6): при значении "1" все
# НОВЫЕ проекты резолвятся в sandbox-провайдер независимо от
# PREVIEW_PROVIDER. Существующие projects сохраняют pinned capabilities
# (ADR-015). Используется при поломке static-pipeline'а.
# PREVIEW_PROVIDER_FORCE_SANDBOX=0

# -------- Deploy (Kamal — опционально) --------
DEPLOY_PROVIDER=kamal
# DEPLOY_* переменные — уточняются в Phase 5.

# -------- Identity / ACL --------
# Где персистится ACL для identity-cookie сессий. Файл создаётся
# автоматически. В тестах перезаписывается на tmp-путь.
# ADORABLE_ACL_FILE=./.adorable/acl.json
# Dev-only удобство: при значении "1" любой новый identity получает
# write на все обнаруженные wrapper-репо. НЕ ВКЛЮЧАТЬ в проде.
# ADORABLE_DEV_AUTO_GRANT=0

# -------- Gitea (multi-org) --------
# По умолчанию все wrapper-репо создаются под GITEA_ADMIN_USER. Если
# хочешь отделить org для adorable-проектов — установи. Должна быть
# отличной от GITEA_ADMIN_USER.
# GITEA_ORG=

# -------- Deploy --------
# Domain-suffix для deploy URL (current commit short-sha + этот suffix).
# Default — "deploy.localhost".
# DEPLOYMENT_DOMAIN_SUFFIX=deploy.localhost

# -------- Runtime --------
NODE_ENV=development
PORT=3000
BUILDER_PORT=3000

# -------- OAuth (опционально) --------
# Github OAuth для Better Auth (если включаете social login)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
