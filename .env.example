# ==============================================================================
# Adorable fork — пример .env. Скопируйте в .env и заполните реальными значениями.
# ==============================================================================

# -------- LLM --------
# Провайдер: zai (основной) | openrouter | anthropic | openai | mock
LLM_PROVIDER=zai

# Z.ai (основной путь — работает из РФ)
Z_AI_API_KEY=
Z_AI_BASE_URL=https://api.z.ai/api/paas/v4

# Основная и быстрая модели
LLM_MAIN_MODEL=glm-5.1
LLM_FAST_MODEL=glm-4.5-air

# Альтернативный путь через OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Fallback (опционально)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# -------- Auth (Better Auth) --------
# Сгенерировать: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# -------- Postgres (app) --------
APP_POSTGRES_PASSWORD=adorable_dev_password
# В self-hosted DATABASE_URL формируется из этого пароля и адреса postgres-app.
DATABASE_URL=postgres://adorable:adorable_dev_password@localhost:5432/adorable

# -------- Gitea --------
GIT_PROVIDER=gitea
# Если 3001 занят на хосте — поменяй GITEA_HOST_PORT (и соответственно GITEA_BASE_URL / GITEA_ROOT_URL).
GITEA_HOST_PORT=3001
GITEA_BASE_URL=http://localhost:3001
GITEA_DOMAIN=localhost
GITEA_ROOT_URL=http://localhost:3001/
# Сгенерировать: openssl rand -base64 24
GITEA_ADMIN_PASSWORD=
GITEA_ADMIN_USER=adorable
GITEA_ADMIN_EMAIL=admin@adorable.local
GITEA_POSTGRES_PASSWORD=gitea_dev_password
# Создаётся скриптом scripts/init-gitea.sh --write-env
GITEA_TOKEN=

# -------- Sandbox (Docker) --------
SANDBOX_PROVIDER=docker
SANDBOX_NETWORK_NAME=adorable_sandboxes
# CPU лимит в долях ядра (NanoCpus = value * 1e9). 2 = 2 ядра.
SANDBOX_CPU_LIMIT=2
# Память в байтах. Next.js dev + Turbopack + агент — тесно в 2 GiB, берём 4.
# 4 GiB = 4294967296
SANDBOX_MEMORY_LIMIT=4294967296
# Next dev + watchers легко делают 500+ процессов. 1024 с запасом.
SANDBOX_PIDS_LIMIT=1024
# Max storage для overlay2+xfs (в байтах). 5 GiB = 5368709120.
# На ext4 оставь пустым — docker откажется создавать контейнер с StorageOpt.
SANDBOX_STORAGE_LIMIT=5368709120
# Размер tmpfs для рабочей директории (`/workspace`). Отдельно от
# SANDBOX_STORAGE_LIMIT, т.к. это in-memory mount. 6 GiB = 6442450944 —
# хватает на Next.js + node_modules + .next cache.
SANDBOX_WORKSPACE_SIZE_BYTES=6442450944
# Размер tmpfs для `/tmp` (npm кэш + rename'ы). 1 GiB = 1073741824.
SANDBOX_TMP_SIZE_BYTES=1073741824
# ulimit nofile — webpack/tsc watch открывает тысячи fd.
SANDBOX_ULIMIT_NOFILE=4096
# TTL и idle-timeout (минут) для sandbox. Cleanup-воркер.
SANDBOX_MAX_LIFETIME_MIN=120
SANDBOX_IDLE_TIMEOUT_MIN=30
SANDBOX_CLEANUP_INTERVAL_SEC=60
# Куда писать audit log (JSON lines)
SANDBOX_AUDIT_LOG=/tmp/adorable-sandbox-audit.log
# Образ sandbox
SANDBOX_IMAGE=node:22-slim
# Путь к сокету Docker хоста (билдер локально) или внутри compose (/var/run/docker.sock пробрасывается)
DOCKER_SOCKET=/var/run/docker.sock

# -------- Proxy (Caddy) --------
PROXY_PROVIDER=caddy
CADDY_ADMIN_URL=http://localhost:2019
# Префикс домена для preview (будет: <sandboxId>.<PREVIEW_DOMAIN_SUFFIX>)
PREVIEW_DOMAIN_SUFFIX=preview.localhost
# http в dev, https в проде
PREVIEW_PROTOCOL=http
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# -------- Deploy (Kamal — опционально) --------
DEPLOY_PROVIDER=kamal
# DEPLOY_* переменные — уточняются в Phase 5.

# -------- Runtime --------
NODE_ENV=development
PORT=3000
BUILDER_PORT=3000

# -------- OAuth (опционально) --------
# Github OAuth для Better Auth (если включаете social login)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
